# Primary provider (any OpenAI-compatible API). Default: Groq. Key: https://console.groq.com
LLM_API_KEY=your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
GEN_MODEL=openai/gpt-oss-20b          # fast model that writes questions
GRADE_MODEL=openai/gpt-oss-120b         # stronger model that grades answers

# Optional fallback if the primary is rate-limited or down (e.g. Gemini's OpenAI-compatible endpoint)
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FALLBACK_MODEL=

PORT=3000
MAIN_QUESTIONS=6
PASS_MARK=60
